{
  "manifest_version": 3,
  "name": "拾藏连接",
  "description": "在你自己的浏览器里登录小红书/抖音等，把登录态安全交给拾藏网站。",
  "version": "0.1.0",
  "key": "",
  "action": {
    "default_title": "拾藏连接",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["cookies", "tabs"],
  "host_permissions": [
    "*://*.xiaohongshu.com/*",
    "*://*.douyin.com/*",
    "*://*.zhihu.com/*",
    "*://*.bilibili.com/*",
    "*://*.refind.cloud/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.refind.cloud/*",
        "https://*.pages.dev/*",
        "http://127.0.0.1/*",
        "http://localhost/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:4173/*",
        "http://localhost:4173/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
