# Local Supabase (after `npx supabase start`)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-status

# Or cloud Supabase (Dashboard → Project Settings → API)
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=replace-with-cloud-anon-key

# Local platform parser (browser → CN network). Start with:
#   python3 tools/platform-parser/server.py
VITE_PLATFORM_PARSER_URL=http://127.0.0.1:8787

# --- Production (Vercel / Cloudflare Pages) ---
# Set these in the host dashboard (NOT committed). Build command: `npm run build:web`
# Output directory: `dist/client`
#
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=replace-with-cloud-anon-key
# VITE_PLATFORM_PARSER_URL=          # leave empty for soft-launch without hosted parser
#                                   # or https://parser.your-domain.tld when Task 3-B is live
# VITE_ALLOW_DEMO_GENERATE=false    # never true in production
#
# Also configure Supabase Auth → URL Configuration:
#   Site URL = https://YOUR_CUSTOM_DOMAIN
#   Redirect URLs include https://YOUR_CUSTOM_DOMAIN/**
#
# See: docs/superpowers/plans/2026-09-19-production-launch.md

# Hosted Office→PDF (Edge secret, NOT VITE_*):
#   docker compose -f tools/office-convert/docker-compose.yml up -d
#   npx supabase secrets set OFFICE_CONVERT_URL=https://YOUR_PUBLIC_GOTENBERG_HOST
#   npx supabase secrets set OFFICE_CONVERT_ENGINE=gotenberg
# Cloud Edge cannot reach localhost; deploy Gotenberg publicly for production.

# Never put service_role in Vite env.
# AI provider keys (for example DEEPSEEK_API_KEY) are Supabase Edge Function
# secrets. Set them with `supabase secrets set`; never expose them as VITE_*.
